{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/CampAsAChamp/readme-screenshot/schema/readme-screenshot.schema.json",
  "title": "readme-screenshot config",
  "type": "object",
  "required": [
    "version",
    "output",
    "server",
    "capture",
    "theme"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "server": {
      "type": "object",
      "required": [
        "start",
        "health_url"
      ],
      "properties": {
        "build": {
          "type": "string"
        },
        "prepare": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "health_url": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "required": [
        "viewport",
        "target"
      ],
      "properties": {
        "viewport": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "selector"
              ],
              "properties": {
                "type": {
                  "const": "element"
                },
                "selector": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "viewport"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "full_page"
                }
              }
            }
          ]
        },
        "mask": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wait_for_animations": {
          "type": "boolean"
        },
        "reduced_motion": {
          "type": "boolean"
        },
        "base_url": {
          "type": "string"
        },
        "auth": {
          "type": "object",
          "required": [
            "login_url",
            "password"
          ],
          "properties": {
            "login_url": {
              "type": "string"
            },
            "password_field": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "wait_for": {
              "type": "string"
            }
          }
        },
        "clock": {
          "type": "object",
          "required": [
            "freeze"
          ],
          "properties": {
            "freeze": {
              "type": "string"
            },
            "timezone": {
              "type": "string"
            }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "required": [
        "modes"
      ],
      "properties": {
        "storage_key": {
          "type": "string"
        },
        "attribute": {
          "type": "string"
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "blend": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "direction": {
          "enum": [
            "tl-br",
            "tr-bl"
          ]
        },
        "blend_width": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "commit": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      }
    }
  }
}

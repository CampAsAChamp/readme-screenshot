{
  "name": "readme-screenshot",
  "version": "1.1.2",
  "description": "Config-driven README screenshot capture with optional light/dark blend",
  "license": "MIT",
  "type": "module",
  "bin": {
    "readme-screenshot": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
